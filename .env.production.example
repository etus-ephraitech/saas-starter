#--------------------------------------------------------------------
# LIVE SERVER environment (cPanel).
#
# On the server:  cp .env.production.example .env && chmod 600 .env
# then fill in every empty value. Never commit .env. See deploy/DEPLOY.md.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# The https address of the system, with the trailing slash.
app.baseURL = 'https://app.example.com/'
# Clean addresses: public/.htaccess sends every request to index.php.
app.indexPage = ''
app.appTimezone = 'Africa/Kampala'
app.forceGlobalSecureRequests = true

# Run once on the server: php spark key:generate
# Keep a copy of the line it writes somewhere safe and offline. Never
# generate a new key for a database that already has data.
encryption.key =

#--------------------------------------------------------------------
# Modules installed on this server (read at boot). Leave both empty to
# install every module in modules/ and in Composer packages.
#   platform.modulesOff  = Payroll, Fleet
#   platform.modulesOnly = Crm, Sales
#--------------------------------------------------------------------
platform.modulesOff =
platform.modulesOnly =

#--------------------------------------------------------------------
# Multi-tenant installs only (Config\Auth::$tenancy = 'multi').
# Tenants at <slug>.<baseDomain> need a wildcard DNS record
# (*.app.example.com) and a wildcard SSL certificate.
#--------------------------------------------------------------------
# platform.baseDomain = 'app.example.com'
# cookie.domain = '.app.example.com'

#--------------------------------------------------------------------
# Database. cPanel puts your account name in front of the database and
# user names (e.g. acct_app and acct_appuser).
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# Sessions and cookies (HTTPS only)
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'app_session'
session.expiration = 7200
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# Email: an account made in cPanel → Email Accounts works well.
# Host is usually mail.<your domain>; port 465 with ssl, or 587 with tls.
#--------------------------------------------------------------------
email.fromEmail = 'no-reply@example.com'
email.fromName = 'Platform'
email.protocol = smtp
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.mailType = html
